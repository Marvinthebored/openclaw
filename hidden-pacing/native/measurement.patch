+// Temporary measurement instrumentation; identical in both native simulator variants.
+public func pacingProofRecord(_ event: String, value: String?, interval: Double) {
+    guard let path = ProcessInfo.processInfo.environment["OPENCLAW_PACING_PROOF_PATH"] else { return }
+    let row: [String: Any] = ["event": event, "t": ProcessInfo.processInfo.systemUptime,
+        "count": value?.count ?? -1, "interval": interval]
+    guard let data = try? JSONSerialization.data(withJSONObject: row),
+          let file = FileHandle(forWritingAtPath: path) else { return }
+    defer { try? file.close() }
+    do { try file.seekToEnd(); try file.write(contentsOf: data + Data([10])) } catch { }
