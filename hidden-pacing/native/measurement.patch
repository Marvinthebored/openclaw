+@MainActor
+final class NativePacingMeasurementUITests: XCTestCase {
+    func testNativeStreamThroughDrawer() throws {
+        continueAfterFailure = false
+        let path = "/Users/Shared/ios-work/native-pacing-measurement.jsonl"
+        FileManager.default.createFile(atPath: path, contents: Data())
+        let app = XCUIApplication()
+        setupSnapshot(app)
+        app.launchEnvironment["OPENCLAW_PACING_PROOF_PATH"] = path
+        app.launchArguments += ["--openclaw-initial-tab", "chat",
+            "--openclaw-initial-destination", "chat", "--openclaw-sidebar-visibility", "hidden",
+            "--openclaw-screenshot-mode", "--openclaw-empty-chat-fixture", "--openclaw-pacing-proof"]
+        app.launch()
+        defer { app.terminate() }
+        let show = app.buttons["RootTabs.Sidebar.Show"]
+        XCTAssertTrue(show.waitForExistence(timeout: 15))
+        let input = app.descendants(matching: .any)["chat-message-input"]
+        XCTAssertTrue(input.waitForExistence(timeout: 10))
+        input.tap(); input.typeText("Measure native pacing")
+        app.buttons["chat-send-message"].tap()
+        self.phase("visible", path: path)
+        self.measureWindow()
+        self.capture(app, "native-stream-visible")
+        show.tap()
+        let hide = app.buttons["RootTabs.Sidebar.Hide"]
+        XCTAssertTrue(hide.waitForExistence(timeout: 5))
+        self.phase("covered", path: path)
+        self.measureWindow()
+        self.capture(app, "native-stream-covered")
+        hide.tap()
+        XCTAssertTrue(show.waitForExistence(timeout: 5))
+        self.phase("revealed", path: path)
+        self.measureWindow()
+        self.capture(app, "native-stream-revealed")
+        let stop = app.buttons["Stop response"]
+        XCTAssertTrue(stop.waitForExistence(timeout: 5))
+        self.phase("stop", path: path)
+        stop.tap()
+        self.measureWindow()
+        let data = try Data(contentsOf: URL(fileURLWithPath: path))
+        let attachment = XCTAttachment(data: data, uniformTypeIdentifier: "public.json")
+        attachment.name = "native-publications.jsonl"; attachment.lifetime = .keepAlways
+        self.add(attachment)
+        let rows = try String(decoding: data, as: UTF8.self).split(separator: "\n").map {
+            try JSONSerialization.jsonObject(with: Data($0.utf8)) as! [String: Any]
+        }
+        XCTAssertTrue(rows.contains { $0["event"] as? String == "input" })
+        XCTAssertTrue(rows.contains { $0["event"] as? String == "display" && ($0["count"] as? Int ?? 0) > 0 })
+        XCTAssertTrue(rows.contains { $0["event"] as? String == "display" && $0["count"] as? Int == -1 })
+        print("NATIVE_PACING_DATA " + String(decoding: data, as: UTF8.self))
+    }
+    private func phase(_ name: String, path: String) {
+        let row: [String: Any] = ["event": name, "t": ProcessInfo.processInfo.systemUptime]
+        let file = FileHandle(forWritingAtPath: path)!
+        defer { try? file.close() }
+        file.seekToEndOfFile()
+        file.write(try! JSONSerialization.data(withJSONObject: row) + Data([10]))
+    }
+    private func measureWindow() {
+        // Performance evidence only; not committed regression coverage.
+        let done = expectation(description: "measurement window")
+        DispatchQueue.main.asyncAfter(deadline: .now() + 4) { done.fulfill() }
+        wait(for: [done], timeout: 6)
+    }
+    private func capture(_ app: XCUIApplication, _ name: String) {
+        let a = XCTAttachment(screenshot: app.screenshot())
+        a.name = name; a.lifetime = .keepAlways; self.add(a)
+    }
+}
