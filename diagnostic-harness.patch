diff --git a/apps/ios/UITests/OpenClawSnapshotUITests.swift b/apps/ios/UITests/OpenClawSnapshotUITests.swift
index 60605420440d..ef23d8e12666 100644
--- a/apps/ios/UITests/OpenClawSnapshotUITests.swift
+++ b/apps/ios/UITests/OpenClawSnapshotUITests.swift
@@ -44,6 +44,62 @@ final class OpenClawSnapshotUITests: XCTestCase {
         try super.tearDownWithError()
     }
 
+
+    func testPerformanceReviewProof() throws {
+        self.launchApp(for: Self.chatScreenshotTarget, additionalArguments: ["--openclaw-performance-proof"])
+        let app = try XCTUnwrap(self.app)
+        self.tapSidebarReveal(in: app)
+        let state = app.staticTexts["Proof.Sidebar.State"]
+        let row = app.buttons["Proof.Session.agent:main:proof-1"]
+        XCTAssertTrue(row.waitForExistence(timeout: 10))
+        XCTAssertTrue(state.waitForExistence(timeout: 5))
+        XCTAssertTrue(state.label.contains("rows=40"), state.label)
+        XCTAssertTrue(state.label.contains("type=small"), state.label)
+        let initialValue = try XCTUnwrap(row.value as? String)
+        XCTAssertTrue(initialValue.contains("Proof session 01"), initialValue)
+        self.attachScreenshot(named: "proof-populated-drawer-small")
+        row.press(forDuration: 1)
+        XCTAssertTrue(app.buttons["Pin"].waitForExistence(timeout: 5), "Real session menu was not presented")
+        XCTAssertTrue(app.buttons["Rename…"].exists)
+        XCTAssertTrue(app.buttons["Fork"].exists)
+        self.attachScreenshot(named: "proof-session-menu")
+        // Tap outside the system context menu, away from any menu action.
+        app.coordinate(withNormalizedOffset: CGVector(dx: 0.93, dy: 0.75)).tap()
+        XCTAssertTrue(app.buttons["Pin"].waitForNonExistence(timeout: 5))
+        row.tap()
+        XCTAssertTrue(app.buttons["RootTabs.Sidebar.Show"].waitForExistence(timeout: 5))
+        self.attachScreenshot(named: "proof-selected-chat")
+        self.tapSidebarReveal(in: app)
+        XCTAssertTrue(row.waitForExistence(timeout: 5))
+        let selected = NSPredicate(format: "value BEGINSWITH %@", "selected;")
+        XCTAssertEqual(XCTWaiter.wait(for: [XCTNSPredicateExpectation(predicate: selected, object: row)], timeout: 5), .completed)
+        XCTAssertTrue(state.label.contains("selected=agent:main:proof-1"), state.label)
+        self.attachScreenshot(named: "proof-selection-retained-reopen")
+        let title = app.staticTexts["Proof.Title.agent:main:proof-1"]
+        XCTAssertTrue(title.exists)
+        let smallHeight = title.frame.height
+        app.buttons["Proof.Sidebar.Large"].tap()
+        let large = NSPredicate(format: "label CONTAINS %@", "type=xxxLarge")
+        let largeExpectation = XCTNSPredicateExpectation(predicate: large, object: state)
+        XCTAssertEqual(XCTWaiter.wait(for: [largeExpectation], timeout: 10), .completed)
+        XCTAssertGreaterThan(title.frame.height, smallHeight, "Runtime type trait changed without title growth")
+        self.attachScreenshot(named: "proof-large-type")
+        let priorRoster = try XCTUnwrap(row.value as? String)
+        app.buttons["Proof.Sidebar.Roster"].tap()
+        let replaced = NSPredicate(format: "value != %@", priorRoster)
+        let replacementExpectation = XCTNSPredicateExpectation(predicate: replaced, object: row)
+        XCTAssertEqual(XCTWaiter.wait(for: [replacementExpectation], timeout: 10), .completed)
+        XCTAssertTrue((row.value as? String)?.hasPrefix("selected;") == true)
+        XCTAssertTrue(state.label.contains("rows=40"), state.label)
+        self.attachScreenshot(named: "proof-roster-replaced-selection-retained")
+        app.buttons["Proof.Sidebar.Small"].tap()
+        let smallExpectation = XCTNSPredicateExpectation(predicate: NSPredicate(format: "label CONTAINS %@", "type=small"), object: state)
+        XCTAssertEqual(XCTWaiter.wait(for: [smallExpectation], timeout: 10), .completed)
+        XCTAssertEqual(title.frame.height, smallHeight, accuracy: 2, "Small title geometry did not restore")
+        XCTAssertTrue((row.value as? String)?.hasPrefix("selected;") == true)
+        self.attachScreenshot(named: "proof-small-type-restored")
+    }
+
     func testReleaseControlScreenshot() {
         self.captureReleaseScreenshot(Self.controlScreenshotTarget)
     }
