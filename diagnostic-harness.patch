+    func testPerformanceReviewProof() async throws {
+        self.launchApp(for: Self.chatScreenshotTarget, additionalArguments: ["--openclaw-performance-proof"])
+        let app = try XCTUnwrap(self.app)
+        let input = self.chatMessageInput(in: app)
+        XCTAssertTrue(input.waitForExistence(timeout: 8))
+        input.tap(); input.typeText("Synthetic performance proof")
+        app.buttons["chat-send-message"].tap()
+        let transcript = app.scrollViews["chat-transcript"]
+        transcript.coordinate(withNormalizedOffset: CGVector(dx: 0.95, dy: 0.05)).tap()
+        self.attachScreenshot(named: "proof-run-start")
+        let output = app.staticTexts.matching(NSPredicate(format: "label CONTAINS %@", "Synthetic paced response line.")).firstMatch
+        XCTAssertTrue(output.waitForExistence(timeout: 12))
+        self.attachScreenshot(named: "proof-live-edge")
+        transcript.swipeDown(); transcript.swipeDown()
+        self.attachScreenshot(named: "proof-paused-reader")
+        let anchor = app.staticTexts.matching(NSPredicate(format: "label BEGINSWITH %@", "Synthetic history row ")).allElementsBoundByIndex.first { $0.isHittable }
+        let pausedAnchor = try XCTUnwrap(anchor, "No synthetic history anchor visible after pausing")
+        let pausedY = pausedAnchor.frame.minY
+        try await Task.sleep(for: .seconds(2))
+        XCTAssertEqual(pausedAnchor.frame.minY, pausedY, accuracy: 2, "Paced growth moved the paused reader")
+        self.attachScreenshot(named: "proof-paused-reader-stable")
+        XCTAssertTrue(app.buttons["Stop response"].waitForNonExistence(timeout: 35))
+        self.attachScreenshot(named: "proof-completion-paused")
+        transcript.swipeUp(); transcript.swipeUp()
+        XCTAssertTrue(output.exists)
+        self.attachScreenshot(named: "proof-settled")
+    }
+
     func testReleaseControlScreenshot() {
         self.captureReleaseScreenshot(Self.controlScreenshotTarget)
     }
